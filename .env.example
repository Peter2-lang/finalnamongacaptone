# ============================================================================
# DA Hinunangan Swine Registry & Biosurveillance System
# Environment Configuration for Supabase + Vercel + Google APIs
# ============================================================================

# 1. Supabase PostgreSQL database connection
# Copy this from Supabase Dashboard -> Project Settings -> Database -> Connection string
# Vercel runtime: copy the exact Transaction pooler URI (port 6543) from Connect.
# TLS identity verification is enforced by the server; URI SSL parameters are normalized.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Optional: database CA PEM from Supabase if the certificate is not trusted by Node.
# Store multiline PEM or literal \n line breaks. Never disable certificate verification.
DATABASE_SSL_CA=
# Optional migration-only direct/session URI; the runtime does not use DIRECT_URL.
DIRECT_URL=

# 2. Supabase project values. All URLs/keys must belong to the same project.
# The VITE_* publishable key is embedded in the browser build and is safe to expose.
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=[YOUR_SUPABASE_PUBLISHABLE_KEY]
# Server runtime values must match the browser project; publishable key is safe for Auth token verification.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=[YOUR_SUPABASE_PUBLISHABLE_KEY]
# Server-only Supabase secret key for Auth Admin and Storage operations.
# Never add a VITE_ prefix or expose this value in frontend code.
SUPABASE_SECRET_KEY=

# 3. AI keys
GEMINI_API_KEY=your-gemini-api-key-here

# 4. Runtime mode
NODE_ENV=production

# 5. Optional Google Maps
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
